# Test environment. Loaded by vitest.config.js and playwright.config.js.
# Contains no real secrets; values here are for a local, disposable test database only.
SITE_ENV=test
SITE_ORIGIN=http://localhost:3100
PORT=3100
LOG_LEVEL=warn

# Disposable local test database (used from Phase 2). Integration tests drop and recreate its tables.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wtc_test
DB_USER=wtc_test
DB_PASSWORD=wtc_test_local_only

SESSION_SECRET=test-session-secret-not-for-real-use
CSRF_SECRET=test-csrf-secret-not-for-real-use
IP_HASH_SALT=test-ip-hash-salt-not-for-real-use

# Empty SMTP host means tests use a stub transport, never a real server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
ENQUIRY_TO=

GTM_CONTAINER_ID=
UPLOADS_DIR=
SEED_CONFIRM=
