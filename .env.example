# Copy to .env for local development. Never commit .env. On Hostinger, set these in hPanel.

# Environment mode: development | test | staging | production. Anything but production sends noindex.
SITE_ENV=development
# Public origin with scheme and no trailing slash; builds canonicals, sitemap and structured data URLs.
SITE_ORIGIN=http://localhost:3000
# Port the Node process listens on; Hostinger may set this itself.
PORT=3000
# Minimum log level: error | warn | info | debug. Enquiry contents are never logged at any level.
LOG_LEVEL=info

# MySQL host name (Phase 2 onward).
DB_HOST=127.0.0.1
# MySQL port.
DB_PORT=3306
# MySQL database name; staging and production use separate databases.
DB_NAME=wtc_dev
# MySQL user with rights on DB_NAME only.
DB_USER=wtc_dev
# MySQL password for DB_USER.
DB_PASSWORD=

# Secret that signs session cookies; long random string, different per environment (Phase 4).
SESSION_SECRET=
# Secret for the csrf-csrf double-submit token; long random string, different per environment (Phase 2).
CSRF_SECRET=
# Secret salt for hashing visitor IP addresses; the raw IP is never stored (Phase 2).
IP_HASH_SALT=

# SMTP server host for enquiry email; leave empty in development to use Ethereal (Phase 2).
SMTP_HOST=
# SMTP port, usually 465 (TLS) or 587 (STARTTLS).
SMTP_PORT=587
# true for implicit TLS on port 465, false for STARTTLS.
SMTP_SECURE=false
# SMTP user name.
SMTP_USER=
# SMTP password.
SMTP_PASSWORD=
# From address on enquiry notification emails; its domain needs SPF and DKIM.
MAIL_FROM=
# Inbox that receives enquiry notifications (open question Q28).
ENQUIRY_TO=

# Google Tag Manager container ID, e.g. GTM-XXXXXXX; empty disables the GTM snippet (open question Q36).
GTM_CONTAINER_ID=

# Absolute path for uploaded images, outside the repository (Phase 4).
UPLOADS_DIR=

# Must be exactly "yes" to allow npm run seed against production (Phase 3).
SEED_CONFIRM=
